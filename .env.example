# python-ai-service-v2 environment — names only, never commit values.
# Validated at startup by app/core/config.py (Settings): a missing/invalid value stops the service.

# Required
OPENAI_API_KEY=
# PostgreSQL connection string (set per environment; Railway injects this)
DATABASE_URL=
# Shared bearer secret for Nest -> Python gRPC; same value as the backend. >= 32 chars in production.
INTERNAL_RPC_SECRET=
# development | test | production
ENVIRONMENT=development

# Optional: send patient photos to the vision model (D-014). Default false; keep false for launch.
PATIENT_IMAGE_ANALYSIS_ENABLED=false

# Optional model configuration (defaults in app/core/config.py)
FLAGSHIP_MODEL=gpt-5.6-luna
EXTRACTOR_MODEL=gpt-5.6-terra
CHEAP_MODEL=gpt-5.6-luna
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-large
# Must match the pgvector column size
EMBEDDING_DIMENSIONS=3072
FLAGSHIP_TEMPERATURE=0.3
EXTRACTOR_TEMPERATURE=0.1
CHEAP_TEMPERATURE=0.0

# gRPC listener port
GRPC_PORT=50051

# Model call limits (KI-055). TURN_DEADLINE_SECONDS must stay under Nest's 30 s gRPC timeout.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
TURN_DEADLINE_SECONDS=25

# Internal gRPC transport (KI-002) — same switch name as the backend.
# required (default): server cert + key as file paths or base64 PEM (*_B64); missing material stops startup.
# disabled: plaintext, only with INTERNAL_GRPC_PRIVATE_NETWORK=true (logs a warning). Local dev: disabled + true.
INTERNAL_GRPC_TLS=required
INTERNAL_GRPC_PRIVATE_NETWORK=false
INTERNAL_GRPC_TLS_CERT=
INTERNAL_GRPC_TLS_KEY=
INTERNAL_GRPC_TLS_CERT_B64=
INTERNAL_GRPC_TLS_KEY_B64=
