# backend-v2 environment — names only. Never commit real values.
# Validated at startup by src/config/env.validation.ts (the process exits on a missing/invalid value).

NODE_ENV=development            # development | test | production
PORT=3000                       # Nest defaults to 3001 = Next's dev port (KI-004)

# Postgres: DATABASE_URL = migration/admin role (db:deploy); RUNTIME_DATABASE_URL = least-privilege runtime role.
DATABASE_URL=
RUNTIME_DATABASE_URL=
REDIS_URL=                      # redis:// or rediss://

# Auth: secrets >= 32 chars in production, access != refresh. Expirations: 900, 15m, 12h, 7d (access <= 1 day, refresh <= 90 days).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Meta webhook (channel tokens live in encrypted Credential records).
META_APP_SECRET=
META_VERIFY_TOKEN=

# Persistent 32-byte base64 key for Credential encryption; must survive deploys and match backups.
INTEGRATION_CREDENTIAL_KEY=

# Internal gRPC to the Python AI service.
INTERNAL_RPC_SECRET=            # same value as the Python service
PYTHON_SERVER_URL=localhost:50051   # host:port; required in production

# Internal gRPC transport (KI-002) — same switch name as the Python service.
# required (default): trust the CA that signed the Python server certificate (file path or base64 PEM).
# disabled: plaintext, only with INTERNAL_GRPC_PRIVATE_NETWORK=true (logs a warning). Local dev: disabled + true.
INTERNAL_GRPC_TLS=required
INTERNAL_GRPC_PRIVATE_NETWORK=false
INTERNAL_GRPC_TLS_CA=
INTERNAL_GRPC_TLS_CA_B64=
INTERNAL_GRPC_TLS_SERVER_NAME=  # optional: name to check in the server certificate

# Comma-separated dashboard origins (CORS, CSRF, Socket.IO); required in production.
FRONTEND_URL=http://localhost:3001

# Optional
PATIENT_MEDIA_RETENTION_DAYS=30 # 1..3650
# Bearer token for /metrics in production (>= 32 chars); unset = /metrics disabled in production.
METRICS_TOKEN=

# Deploy-time only (npm run db:deploy): runtime DB role passwords (KI-013), >= 32 printable chars,
# no quotes/backslash/space. Required when NODE_ENV=production; elsewhere a missing one only warns.
OMNIX_BACKEND_RUNTIME_DB_PASSWORD=
OMNIX_PYTHON_RUNTIME_DB_PASSWORD=
