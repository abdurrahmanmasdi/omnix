{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(npx prisma migrate reset:*)"
    ],
    "ask": [
      "Bash(npm run db:deploy:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(git push:*)"
    ]
  }
}
